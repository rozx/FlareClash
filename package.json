{
  "name": "flareclash",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "dry-run": "wrangler deploy --dry-run",
    "db:migrate": "wrangler d1 migrations apply flareclash --local",
    "db:migrate:remote": "wrangler d1 migrations apply flareclash --remote",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "hono": "^4.6.16",
    "yaml": "^2.7.0"
  },
  "devDependencies": {
    "@cloudflare/vitest-pool-workers": "^0.8.19",
    "@cloudflare/workers-types": "^4.20250906.0",
    "typescript": "^5.7.3",
    "vitest": "^3.0.5",
    "wrangler": "4.35.0"
  }
}
