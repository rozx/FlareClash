{
  "name": "flareclash",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wrangler dev --define 'COMMIT_HASH:\"'$(git rev-parse --short HEAD)'\"'",
    "deploy": "wrangler deploy --define 'COMMIT_HASH:\"'$(git rev-parse --short HEAD)'\"'",
    "dry-run": "wrangler deploy --dry-run --define 'COMMIT_HASH:\"'$(git rev-parse --short HEAD)'\"'",
    "db:migrate": "wrangler d1 migrations apply flareclash --local",
    "db:migrate:remote": "wrangler d1 migrations apply flareclash --remote",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "hono": "^4.6.16",
    "yaml": "^2.7.0"
  },
  "devDependencies": {
    "@cloudflare/vitest-pool-workers": "^0.22.0",
    "@cloudflare/workers-types": "^5.20260826.1",
    "typescript": "^5.7.3",
    "vitest": "^4.1.11",
    "wrangler": "^4.126.0"
  }
}
